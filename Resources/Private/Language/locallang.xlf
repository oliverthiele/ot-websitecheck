      <trans-unit id="archive.import.conflicts" resname="archive.import.conflicts">
        <source>A label in this file is used by another record here. Rename or delete that record, or read the file in with websitecheck:importsnapshots --label-suffix.</source>
      </trans-unit>
      <trans-unit id="archive.delete.confirmTitle" resname="archive.delete.confirmTitle">
        <source>Delete the file?</source>
      </trans-unit>
      <trans-unit id="archive.delete.confirm" resname="archive.delete.confirm">
        <source>"%1$s" is deleted from the directory. It may be the only copy of these snapshots.</source>
      </trans-unit>
      <trans-unit id="archive.save" resname="archive.save">
        <source>Save as file</source>
      </trans-unit>
      <trans-unit id="archive.save.help" resname="archive.save.help">
        <source>Saves this snapshot to the archive directory, so it survives a replaced database.</source>
      </trans-unit>
      <trans-unit id="archive.saveRun" resname="archive.saveRun">
        <source>Save run as file</source>
      </trans-unit>
      <trans-unit id="archive.saveRun.help" resname="archive.saveRun.help">
        <source>Saves this run with its results and the snapshots it compared — after the switch, its reference results can no longer be requested.</source>
      </trans-unit>
