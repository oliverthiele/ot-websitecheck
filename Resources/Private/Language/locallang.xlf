      </trans-unit>
      <trans-unit id="warning.recordIdentityUnknown.description" resname="warning.recordIdentityUnknown.description">
        <source>Several URLs render this page without a record marker — probably a detail page. Which record is shown cannot be compared.</source>
      </trans-unit>
      <trans-unit id="warning.duplicateDetailPage" resname="warning.duplicateDetailPage">
        <source>Duplicate detail page</source>
      </trans-unit>
      <trans-unit id="warning.duplicateDetailPage.description" resname="warning.duplicateDetailPage.description">
        <source>The same record is rendered by more than one page. That is duplicate content.</source>
      </trans-unit>
